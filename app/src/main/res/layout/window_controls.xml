<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/window_controls_bg"
    android:elevation="5dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/window_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

    <ImageView
        android:id="@+id/window_minimize_btn"
        android:layout_width="40dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/minimize"
        android:padding="5dp"
        android:src="@drawable/ic_minimize" />

    <ImageView
        android:id="@+id/window_close_btn"
        android:layout_width="40dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/close"
        android:padding="5dp"
        android:src="@drawable/ic_close" />

    </LinearLayout>

    <TextView
        android:id="@+id/window_notice"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:text="@string/close_needs_shizuku"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
